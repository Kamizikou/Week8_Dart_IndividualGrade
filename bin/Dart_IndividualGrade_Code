double processStudentScores(List<String> rawScores) {
  double totalScore = 0.0;

  for (int i = 0; i < rawScores.length; i++) {
    print('\n--- Processing Score #${i + 1} ("${rawScores[i]}") ---');

    try {
      double score = double.parse(rawScores[i]);

      // Simple, standard grade branching
      if (score < 0 || score > 100) {
        throw ArgumentError('Score must be between 0 and 100.');
      } else if (score >= 90) {
        print('Excellent performance: $score');
        totalScore += score;
      } else if (score >= 75) {
        print('Passing score: $score');
        totalScore += score;
      } else {
        print('Needs improvement: $score');
        totalScore += score;
      }
    } catch (e) {
      print('Error encountered processing score "${rawScores[i]}": $e');
      print('Skipping invalid input and continuing execution safely.');
    }
  }

  return totalScore;
}

void main() {
  print('==================================================');
  print('  PC16: Dart Logic Problem Set - Test Execution   ');
  print('==================================================');

  List<String> testScores = [
    '93.5',    
    '82.0',    
    '60.0',    
    'invalid', 
    '-15.0',   
    '100.0'    
  ];

  // FUNCTION CALL
  double finalTotal = processStudentScores(testScores);

  print('\n==================================================');
  print('FINAL RESULT');
  print('Total Combined Processed Score: $finalTotal');
  print('==================================================');
}
